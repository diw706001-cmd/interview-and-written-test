NODE_ENV=production
PORT=3000
HR_AUTH_REQUIRED=true
HR_MAX_BODY_BYTES=1048576
HR_DATA_FILE=/app/data/state.json
HR_UPLOAD_ROOT=/app/data/uploads
HR_ADMIN_TOKEN=generate-a-unique-token-at-least-32-characters
HR_HR_TOKEN=generate-a-different-token-at-least-32-characters
HR_VIEWER_TOKEN=generate-a-third-token-at-least-32-characters
MYSQL_HOST=115.190.238.188
MYSQL_PORT=3306
MYSQL_DATABASE=wd
MYSQL_USER=wd_app
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_SSL_VERIFY=true
MYSQL_SSL_CA=/app/certs/mysql-ca.pem
MYSQL_CONNECTION_LIMIT=10
